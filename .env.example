# MEDIVAULT — Environment Variables
# Copy this file to `.env` and adjust for your environment.

# Prisma SQLite database URL.
# For local dev: file:./db/medivault.db  (relative to project root)
# For production SQLite: file:/data/medivault.db  (absolute path on the server)
DATABASE_URL=file:./db/medivault.db

# (Optional) Override the port for `npm start`. Default is 3000.
# PORT=3000
