# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env
.env.local
.env.*.local

# Keep the example committed
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Logs
*.log
dev.log
server.log

# Database files (SQLite — runtime data, not source)
db/*.db
db/*.db-journal
db/*.db-wal
db/*.db-shm

# Sandbox / agent artifacts (local-only)
local-*
.claude
.z-ai-config
.zscripts
prompt
test
worklog.md

# Verification screenshots (don't ship these)
verify-*.png

# Sandbox gateway config (specific to local dev sandbox)
Caddyfile

# Local download artifacts
/download/

# Local DB files (runtime data — should never be committed)
db/*.db
db/*.db-journal

# Skills directory (local skill files)
/skills/

# OS files
Thumbs.db

# IDE
.idea/
.vscode/
*.swp
*.swo
